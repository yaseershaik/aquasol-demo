# 1. DATABASE CONNECTION
# Local Development (SQLite):
DATABASE_URL="file:./dev.db"

# Free Cloud Production (Neon.tech or Supabase PostgreSQL):
# Sign up at https://neon.tech (free) or https://supabase.com (free) to get your connection string:
# DATABASE_URL="postgresql://username:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. AUTHENTICATION & SECURITY
# Generate a strong 32+ character random string for production
JWT_SECRET="aquasol_puregrid_master_secure_production_key_2026_replace_with_random_string"
NODE_ENV="production"

# 3. INITIAL ADMIN CREDENTIALS (for initial database seeding)
ADMIN_EMAIL="admin@puregridsystems.in"
ADMIN_PASSWORD="Admin@12345"

# 4. TRANSACTIONAL EMAIL (Optional - for real email dispatch)
# Sign up at https://resend.com (free tier: 3,000 emails/month)
RESEND_API_KEY=""
EMAIL_FROM="AQUASOL Systems <noreply@yourdomain.com>"

# 5. PAYMENT GATEWAY (Optional - for online payments)
# Test or Live keys from https://razorpay.com
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
