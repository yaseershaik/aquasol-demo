generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model SiteConfig {
  id                String   @id @default("default")
  businessName      String   @default("PureGrid Systems")
  tagline           String   @default("Commercial RO Plants, Spare Parts & Residential Solar Installations")
  phone             String   @default("+91 98765 43210")
  whatsapp          String   @default("919876543210")
  email             String   @default("contact@puregridsystems.in")
  address           String   @default("Industrial Estate, Main Road, India")
  serviceCities     String   @default("Pan-India Parts Delivery | Local Site Inspections")
  heroTitle         String   @default("Reliable Water Purification & Rooftop Solar Power")
  heroSubtitle      String   @default("Order genuine RO spare parts across India, schedule a site inspection, or request a custom installation quote.")
  heroBannerUrl     String?
  roBannerUrl       String?
  solarBannerUrl    String?
  codEnabled        Boolean  @default(true)
  onlinePayEnabled  Boolean  @default(true)
  shippingFlatFee   Float    @default(99)
  freeShippingAbove Float    @default(2500)
  updatedAt         DateTime @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  vertical    String    // "RO" | "SOLAR"
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
}

model Product {
  id             String      @id @default(cuid())
  name           String
  slug           String      @unique
  sku            String      @unique
  vertical       String      // "RO" | "SOLAR"
  shortSummary   String
  description    String
  price          Float
  compareAtPrice Float?
  gstPercent     Float       @default(18)
  stockQuantity  Int         @default(0)
  isFeatured     Boolean     @default(false)
  isPublished    Boolean     @default(true)
  images         String      // JSON array of strings: ["/uploads/..."]
  specifications String      // JSON array of { "key": string, "value": string }
  categoryId     String
  category       Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems     OrderItem[]
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerName      String
  customerPhone     String
  customerEmail     String?
  shippingAddress   String
  city              String
  state             String
  pincode           String
  paymentMethod     String      // "ONLINE" | "COD"
  paymentStatus     String      @default("PENDING") // "PENDING" | "PAID" | "FAILED"
  razorpayOrderId   String?
  razorpayPaymentId String?
  orderStatus       String      @default("PLACED") // "PLACED" | "CONFIRMED" | "PACKED" | "SHIPPED" | "DELIVERED" | "CANCELLED"
  courierName       String?
  trackingNumber    String?
  subtotal          Float
  gstAmount         Float
  shippingFee       Float
  totalAmount       Float
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName String
  sku         String
  quantity    Int
  unitPrice   Float
  gstPercent  Float
}

model InspectionBooking {
  id            String   @id @default(cuid())
  bookingNumber String   @unique
  serviceType   String   // "COMMERCIAL_RO" | "RESIDENTIAL_SOLAR"
  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  city          String
  pincode       String
  preferredDate String   // YYYY-MM-DD
  timeSlot      String   // "09:00 AM - 12:00 PM" | "12:00 PM - 04:00 PM" | "04:00 PM - 07:00 PM"
  notes         String?
  assignedTech  String?
  status        String   @default("PENDING") // "PENDING" | "CONFIRMED" | "COMPLETED" | "CANCELLED"
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model LeadQuote {
  id               String   @id @default(cuid())
  leadNumber       String   @unique
  serviceType      String   // "COMMERCIAL_RO" | "RESIDENTIAL_SOLAR"
  customerName     String
  customerPhone    String
  customerEmail    String?
  city             String
  technicalDetails String   // JSON string of specs (capacity/TDS/roof/bill/notes)
  status           String   @default("NEW") // "NEW" | "CONTACTED" | "QUOTE_SENT" | "WON" | "CLOSED"
  adminNotes       String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PortfolioProject {
  id          String   @id @default(cuid())
  title       String
  vertical    String   // "RO" | "SOLAR"
  location    String
  capacity    String
  summary     String
  imageUrl    String?
  createdAt   DateTime @default(now())
}

model CustomerUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String
  passwordHash String
  companyName  String?
  gstin        String?
  address      String?
  city         String?
  state        String?   @default("Andhra Pradesh")
  pincode      String?
  isActive     Boolean   @default(true)
  role         String    @default("customer") // "customer" | "b2b"
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
}
